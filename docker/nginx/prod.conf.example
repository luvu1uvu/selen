# ПРИМЕР production-конфигурации nginx (будет доработан на этапе деплоя).
#   /api, /sanctum, /up → php-fpm
#   всё остальное       → собранная SPA (frontend/dist), с fallback на index.html
# TLS, заголовки безопасности и кеширование статики настраиваются на этапе деплоя.

server {
    listen 80;
    server_name selen.example.ru;
    client_max_body_size 20m;

    root /var/www/frontend/dist;
    index index.html;

    # Загрузка вложений — до 100 МБ (ADR-0010; согласовано с php.ini и валидацией). Остальной API — 20 МБ.
    # Regex-location проверяются по порядку: этот должен идти раньше общего /api.
    location ~ ^/api/v1/cards/[^/]+/attachments$ {
        client_max_body_size 101m;
        fastcgi_pass php:9000;
        include fastcgi_params;
        # X-Forwarded-For собирает nginx: цепочка прокси + адрес соединения. Laravel читает её, только если адрес
        # соединения в TRUSTED_PROXIES (стенд за tailscale serve), и берёт крайний правый адрес не из них —
        # присланное клиентом IP не становится. TRUSTED_PROXIES пустой — IP = адрес соединения (LATER-61, ADR-0021)
        fastcgi_param HTTP_X_FORWARDED_FOR $proxy_add_x_forwarded_for;
        fastcgi_param SCRIPT_FILENAME /var/www/backend/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param DOCUMENT_ROOT /var/www/backend/public;
        fastcgi_read_timeout 300s;
    }

    # /files/{id} — ссылка на файл вложения, которую открывает сам браузер (UI-1b, LATER-51): веб-маршрут Laravel
    location ~ ^/(api|sanctum|up|files)(/|$) {
        fastcgi_pass php:9000;
        include fastcgi_params;
        fastcgi_param HTTP_X_FORWARDED_FOR $proxy_add_x_forwarded_for;
        fastcgi_param SCRIPT_FILENAME /var/www/backend/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param DOCUMENT_ROOT /var/www/backend/public;
    }

    # Файлы сборки Vite содержат хеш в имени — их можно кешировать надолго
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Файлы вложений: Laravel проверяет доступ к карточке и отвечает X-Accel-Redirect, файл отдаёт nginx
    # (Range-запросы и перемотка видео). Снаружи location недоступен. Content-Type и Content-Disposition
    # nginx берёт из ответа Laravel; защитные заголовки — здесь (заголовки ответа Laravel сюда не доходят).
    location /_protected/attachments/ {
        internal;
        alias /var/www/backend/storage/app/private/attachments/;
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
        add_header Cache-Control "private, max-age=3600" always;
    }

    # Тот же каталог — для PDF, открытого в браузере по ссылке /files/{id} (тип — по содержимому, решение PM 21.10):
    # без sandbox (с ним Chrome PDF не показывает), встроенный просмотрщик — object-src 'self'
    # (AttachmentFiles::PDF_CSP); nosniff — как у остальных файлов
    location /_protected/attachments-pdf/ {
        internal;
        alias /var/www/backend/storage/app/private/attachments/;
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Security-Policy "default-src 'none'; object-src 'self'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
        add_header Cache-Control "private, max-age=3600" always;
    }

    location / {
        try_files $uri /index.html;
    }
}
