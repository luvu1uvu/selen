# Окружение E2E-стека (docker-compose.e2e.yml). Только для тестов: ключ и пароли — не секреты.
APP_NAME=Selen
APP_ENV=e2e
APP_KEY=base64:ZTJlLW9ubHkta2V5LXNlbGVuLWUyZS10ZXN0aW5nISE=
APP_DEBUG=true
APP_URL=http://nginx
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU
BCRYPT_ROUNDS=4
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=selen_e2e
# Роли — как в dev (docs/adr/0016-db-roles.md)
DB_USERNAME=selen_app
DB_PASSWORD=secret
DB_OWNER_USERNAME=selen_owner
DB_OWNER_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Playwright ходит на http://nginx, для ручной проверки — адрес, который печатает scripts/e2e.sh (порт случайный)
SANCTUM_STATEFUL_DOMAINS=nginx,localhost:*,127.0.0.1:*

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
CACHE_PREFIX=selen_e2e_
QUEUE_CONNECTION=sync
MAIL_MAILER=log
FRONTEND_URL=http://nginx
# Вложения — в каталоге, общем с nginx стека E2E (не в dev-каталоге backend/storage)
ATTACHMENTS_ROOT=/var/www/attachments
