# =============================================================================
# Копия бэкапов стенда вне Mac mini — restic → S3-совместимое хранилище в РФ (ADR-0018; docs/runbook.md,
# «Mac mini как хост»).
#
# Это ШАБЛОН. Рабочий файл — ~/.config/selen/offsite.env (права 600): его создаёт `make host-install`,
# значения вписывает PM сам — в git, переписку и логи они не попадают. Не в .env стенда: тот целиком передаётся
# в контейнеры приложения, а ключ хранилища приложению не нужен.
# =============================================================================

# Копия вне Mac mini включена? Решение PM 2026-10-16: до пилота — отключена, бэкапы стенда только на Mac mini.
# false — копия не делается, ни уведомлений, ни «ВНИМАНИЕ» о ней (make host-status: «отключена»). Включить — true
# и хранилище ниже (runbook, раздел 13, «Копия вне Mac mini»). Без переменной копия считается включённой.
OFFSITE_ENABLED=false

# Хранилище restic: s3:<адрес S3>/<бакет>/<каталог>
#   Yandex Object Storage: s3:https://storage.yandexcloud.net/<бакет>/selen-pm
#   Selectel:              s3:https://s3.ru-1.storage.selcloud.ru/<бакет>/selen-pm
RESTIC_REPOSITORY=

# Сервисный ключ с доступом только к этому бакету (статический ключ доступа S3). Ключ и регион — обязательно здесь:
# иначе возьмутся одноимённые переменные хранилища вложений из .env приложения
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Регион: Yandex — ru-central1, Selectel — ru-1
AWS_DEFAULT_REGION=ru-central1

# Пароль шифрования restic — отдельный файл (600), его создаёт make host-install. Копию — в менеджер паролей:
# без него копию в облаке не расшифровать
RESTIC_PASSWORD_FILE=
