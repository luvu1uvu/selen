# =============================================================================
# Selen — переменные окружения.
#
# Это ЕДИНСТВЕННЫЙ файл окружения проекта: его читают и docker compose,
# и Laravel (передаётся в контейнеры php/queue/scheduler через env_file).
# Файл backend/.env НЕ используется.
#
# Первый запуск: `make up` сам скопирует этот файл в .env и сгенерирует APP_KEY.
# После изменения .env перезапустите контейнеры: `make restart`.
# Секреты в репозиторий не коммитим: .env в .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Docker: порты на машине разработчика
# -----------------------------------------------------------------------------
# Порт, на котором открывается приложение: http://localhost:8080
APP_PORT=8080
# Веб-интерфейс Mailpit (перехваченные письма): http://localhost:8025
MAILPIT_UI_PORT=8025
# Порт PostgreSQL для внешних клиентов (DBeaver, TablePlus и т. п.)
FORWARD_DB_PORT=54320
# Опрос файлов в Vite: нужен в Docker на macOS (Colima), иначе правки frontend не подхватываются.
# На Linux можно выключить (false) — там работают обычные события файловой системы.
VITE_USE_POLLING=true

# -----------------------------------------------------------------------------
# Приложение
# -----------------------------------------------------------------------------
APP_NAME=Selen
# local | production
APP_ENV=local
# Генерируется автоматически командой `make key` (или при первом `make up`)
APP_KEY=
# В production обязательно false
APP_DEBUG=true
# Публичный адрес приложения (используется в ссылках в письмах)
APP_URL=http://localhost:8080
# Адрес SPA. Совпадает с APP_URL: фронтенд и API работают на одном домене
FRONTEND_URL=http://localhost:8080

# Язык интерфейса и писем
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

# Режим обслуживания хранится в файле (стандарт Laravel)
APP_MAINTENANCE_DRIVER=file

# Стоимость bcrypt-хеширования паролей
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Логи
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# debug | info | notice | warning | error
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# База данных (PostgreSQL). Три роли (docs/adr/0016-db-roles.md); в production — у каждой длинный случайный
# пароль, приложение никогда не подключается суперпользователем.
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
# Имя сервиса в docker compose; в production — адрес сервера БД
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=selen
# Роль приложения (веб, очереди, scheduler): только чтение и запись данных, ничем не владеет
DB_USERNAME=selen_app
DB_PASSWORD=secret
# Владелец схемы: миграции (php artisan migrate --database=pgsql_owner), бэкап и восстановление
DB_OWNER_USERNAME=selen_owner
DB_OWNER_PASSWORD=secret
# Суперпользователь (в Docker — создаёт образ postgres): только перевод базы на роли (make db-roles).
# Приложению не нужен; в production его пароль не хранят в .env сервера
DB_SUPERUSER=selen
DB_SUPERUSER_PASSWORD=secret

# -----------------------------------------------------------------------------
# Сессии (хранятся в PostgreSQL — см. docs/adr/0002-auth-sanctum-spa.md)
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
# Время жизни сессии без «запомнить меня»: минут бездействия (8 часов — рабочий день)
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
# Пусто = текущий домен. В production можно указать домен явно
SESSION_DOMAIN=null
# В production (HTTPS) обязательно true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Домены, с которых SPA получает cookie-аутентификацию Sanctum (host:port)
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost,127.0.0.1:8080

# Доверенные прокси (ADR-0021): адреса или подсети через запятую, чьим X-Forwarded-For / -Proto верим.
# Пусто = никому: IP клиента — адрес соединения, его видит nginx. На dev и на сервере, где nginx — край, пусто.
# Подсеть офиса сюда не вписывать: любой сотрудник снова сможет подменить IP и обойти лимит входа (LATER-61)
TRUSTED_PROXIES=

# -----------------------------------------------------------------------------
# Redis: кеш, очереди, rate limiting
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
CACHE_PREFIX=selen_cache_

QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Вложения карточек (docs/adr/0010-attachments.md). attachments — локальный диск
# backend/storage/app/private/attachments (его же отдаёт nginx и сохраняет scripts/backup.sh);
# s3 — S3-совместимое хранилище, тогда заполните AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# AWS_DEFAULT_REGION, AWS_BUCKET и (для MinIO и т. п.) AWS_ENDPOINT, AWS_USE_PATH_STYLE_ENDPOINT=true.
ATTACHMENTS_DISK=attachments

# -----------------------------------------------------------------------------
# Почта. В dev письма уходят в Mailpit; в production — SMTP-сервер компании.
# Письма отправляются через очередь (сервис queue).
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="selen@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Selen: бизнес-настройки
# -----------------------------------------------------------------------------
# Срок жизни ссылки-приглашения, в часах
SELEN_INVITATION_TTL_HOURS=72
# Срок жизни ссылки сброса пароля, в минутах
SELEN_PASSWORD_RESET_TTL_MINUTES=60

# -----------------------------------------------------------------------------
# Бэкапы (scripts/backup.sh)
# -----------------------------------------------------------------------------
# Каталог для дампов (относительно корня репозитория или абсолютный путь)
BACKUP_DIR=backups
# Ежечасный уровень (каталог hourly/, хранение — часов): 0 — выключен, каждый бэкап — ежедневный (стенд PM — 48)
BACKUP_KEEP_HOURLY=0
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
