# =============================================================================
# Стенд PM — переменные окружения (docs/runbook.md, «Стенд PM»).
#
# Это ШАБЛОН. Рабочий файл — .env в рабочей копии стенда (~/dev/selen-pm/.env):
# его создаёт `make pm-up` при первом запуске и сам генерирует APP_KEY и пароль базы.
# Рабочий .env в .gitignore; секреты стенда в репозиторий не попадают.
# Бэкапы стенда этот файл не содержат — при переносе стенда на другую машину скопируйте его вручную.
# Файл смонтирован в контейнеры — править его только `make pm-*` или редактором, не `sed -i`.
# =============================================================================

# docker compose в каталоге стенда работает с проектом selen-pm, а не с dev-окружением
COMPOSE_FILE=docker-compose.pm.yml

# Порты. Стенд открывается по адресу http://127.0.0.1:8081 — НЕ localhost: cookie браузера общие для всех
# портов одного хоста, и вход в dev (localhost:8080) выкидывал бы со стенда. Письма (Mailpit): http://127.0.0.1:8026
PM_PORT=8081
PM_MAIL_PORT=8026

# -----------------------------------------------------------------------------
# Приложение. production — как на будущем сервере: демо-данные не загружаются,
# migrate:fresh / db:wipe и прочие команды, стирающие базу, запрещены.
# -----------------------------------------------------------------------------
APP_NAME=Selen
APP_ENV=production
# Генерируется make pm-up
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8081
FRONTEND_URL=http://127.0.0.1:8081
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# База данных стенда (свой том postgres проекта selen-pm)
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=selen
# Роли базы (docs/adr/0016-db-roles.md): приложение — selen_app, миграции и бэкапы — selen_owner,
# суперпользователь — только перевод на роли. Пароли генерирует make pm-up (на старом стенде — make pm-update)
DB_USERNAME=selen_app
DB_PASSWORD=
DB_OWNER_USERNAME=selen_owner
DB_OWNER_PASSWORD=
DB_SUPERUSER=selen
DB_SUPERUSER_PASSWORD=

# -----------------------------------------------------------------------------
# Сессии: http на 127.0.0.1 — cookie без Secure; своё имя cookie, чтобы не путаться с dev-сессией
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_COOKIE=selen_pm_session
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8081,localhost:8081
# Доверенные прокси (ADR-0021). Пусто = никому: у всех, кто заходит на стенд, IP — шлюз Docker (172.18.0.1).
# За tailscale serve (runbook, раздел 13) — 172.16.0.0/12: так nginx в Docker видит хост; тогда IP входа через
# Tailscale — адрес устройства в tailnet. Процесс на самом Mac mini при этом может подставить свой IP (компромисс ADR-0021)
TRUSTED_PROXIES=

# -----------------------------------------------------------------------------
# Redis, очереди, почта (письма — в Mailpit стенда)
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
CACHE_STORE=redis
CACHE_PREFIX=selen_pm_
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
ATTACHMENTS_DISK=attachments

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="selen@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SELEN_INVITATION_TTL_HOURS=72
SELEN_PASSWORD_RESET_TTL_MINUTES=60
# Одна компания на копию (ADR-0026); true — несколько компаний и гости (ADR-0024). После изменения — make pm-up
SELEN_MULTI_COMPANY=false

# -----------------------------------------------------------------------------
# Бэкапы стенда (make pm-backup / pm-update; на Mac mini — каждый час, make host-install): вне рабочей копии —
# ~/dev/selen-pm-backups. Хранение (решение PM, ADR-0018): ежечасные — за 48 часов, ежедневные — 30 дней,
# еженедельные — 12 недель; так же — копия в облаке (настройки — ~/.config/selen/offsite.env, не здесь)
# -----------------------------------------------------------------------------
BACKUP_DIR=../selen-pm-backups
BACKUP_KEEP_HOURLY=48
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_WEEKLY=12

# -----------------------------------------------------------------------------
# QA-бот (make pm-qa-bot): заводит карточки на доске «Баги приёмки».
# Пароль генерирует make pm-qa-bot и записывает сюда.
# -----------------------------------------------------------------------------
QA_BOT_EMAIL=qa-bot@selen.local
QA_BOT_PASSWORD=
